# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=karigarji-artifacts

# AI: Gemini (Google AI Studio → https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# AI: HuggingFace FLUX.1-Kontext-dev
# Get your token at https://huggingface.co/settings/tokens
# Free tier available — rate limits apply
HF_TOKEN=your-huggingface-token
HF_FLUX_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# App config
APP_ENV=dev
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
SECRET_KEY=generate-with-openssl-rand-hex-32

# Optional: Error tracking
SENTRY_DSN=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=karigarji-artifacts

# AI: Gemini (Google AI Studio → https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# AI: fal.ai (FLUX Kontext → https://fal.ai/dashboard)
FAL_AI_KEY=your-fal-ai-key
FAL_FLUX_MODEL=fal-ai/flux-kontext/dev

# App config
APP_ENV=dev
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
SECRET_KEY=generate-with-openssl-rand-hex-32

# Optional: Error tracking
SENTRY_DSN=
